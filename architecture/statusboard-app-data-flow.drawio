 as="geometry"><Array as="points"><mxPoint x="1027" y="725"/><mxPoint x="1566" y="725"/></Array></mxGeometry></mxCell><mxCell id="c49" value="10 notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1566" y="860"/><mxPoint x="1725" y="860"/></Array></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="806"/></Array></mxGeometry></mxCell><mxCell id="c51" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=bottom;align=center;fontStyle=1;html=1;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="160" height="430" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Reading the page&lt;/b&gt;&lt;br&gt;1 The browser asks Route 53 for status.domain&lt;br&gt;2-4 HTTPS to the ALB, which forwards to a pod IP&lt;br&gt;5 The app asks Valkey for the cached summary&lt;br&gt;6 On a miss it queries PostgreSQL and caches the result for 30 s&lt;br&gt;&lt;b&gt;Updating an incident&lt;/b&gt;&lt;br&gt;A-B The engineer calls the API with the admin token&lt;br&gt;C The change is written to PostgreSQL&lt;br&gt;D The cached summary is deleted, so the next visitor sees the update at once&lt;br&gt;&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;7-10 Metrics are scraped, graphed and alerted on" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="30" y="648" width="145" height="415" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>